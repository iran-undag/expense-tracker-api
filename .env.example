# Primary SQL Server
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=expensedb;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=replace-me
SPRING_DATASOURCE_MAX_POOL_SIZE=10

# Isolated demo SQL Server. Do not point this at the primary database.
DEMO_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=expensedb_demo;encrypt=false;trustServerCertificate=true
DEMO_DATASOURCE_USERNAME=sa
DEMO_DATASOURCE_PASSWORD=replace-me
DEMO_DATASOURCE_MAX_POOL_SIZE=3
DEMO_DATASOURCE_IDLE_TIMEOUT=300000
DEMO_DATASOURCE_LOGIN_TIMEOUT=30
DEMO_DATASOURCE_CONNECT_RETRY_COUNT=1
DEMO_DATASOURCE_CONNECT_RETRY_INTERVAL=10

# At least 32 random bytes. Keep this server-side and rotate only when all demo sessions may expire.
DEMO_TOKEN_HMAC_KEY=replace-with-at-least-32-random-bytes

# Authentication and browser origin
AUTH_ISSUER_URI=https://replace-me.example.com/tenant/v2.0
JWK_SET_URI=https://replace-me.example.com/tenant/discovery/v2.0/keys
ALLOWED_ORIGIN_PATTERNS=https://expense.example.com
