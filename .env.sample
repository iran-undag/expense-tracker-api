# Sample environment variables for docker-compose
POSTGRES_DB=expensedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example

# Spring datasource overrides (optional)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/expensedb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=example
# SPRING_DATASOURCE_MAX_POOL_SIZE=5

# Auth issuer and container-reachable JWK endpoint
AUTH_ISSUER_URI=http://localhost:9000
JWK_SET_URI=http://host.docker.internal:9000/oauth2/jwks
ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# AI provider (ollama, openvino, or azure; azure calls the external receipt processor function)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENVINO_BASE_URL=http://host.docker.internal:8001
# OPENVINO_CHAT_PATH=/api/vision/chat
# RECEIPT_PROCESSOR_URL=http://host.docker.internal:7071/api/process-receipt
# RECEIPT_PROCESSOR_FUNCTION_KEY=replace-me
