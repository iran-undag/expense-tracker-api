# Sample environment variables for docker-compose
MSSQL_SA_PASSWORD=Example!Passw0rd

# Spring datasource overrides (optional)
# SPRING_DATASOURCE_URL=jdbc:sqlserver://db:1433;databaseName=expensedb;encrypt=false;trustServerCertificate=true
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=${MSSQL_SA_PASSWORD}
# SPRING_DATASOURCE_MAX_POOL_SIZE=5

# Auth issuer and container-reachable JWK endpoint
AUTH_ISSUER_URI=http://localhost:9000
JWK_SET_URI=http://host.docker.internal:9000/oauth2/jwks
ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# AI provider (ollama, openvino, or azure; azure calls the external receipt processor function)
# Shared AI provider HTTP timeouts for Ollama, OpenVINO, and Azure receipt processing
AI_PROVIDER_CONNECT_TIMEOUT=5s
AI_PROVIDER_READ_TIMEOUT=30s

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_OPTIONS_MODEL=gemma4:e2b

#AI_PROVIDER=openvino
#OPENVINO_BASE_URL=http://localhost:8001
#OPENVINO_CHAT_PATH=/api/vision/chat

#AI_PROVIDER=azure
#RECEIPT_PROCESSOR_URL=http://host.docker.internal:7071/api/process-receipt
#RECEIPT_PROCESSOR_FUNCTION_KEY=replace-me

# Azure Speech voice input token service
# Required only when the frontend Voice button should use Azure Speech recognition.
# The browser never receives AZURE_SPEECH_KEY; it receives a short-lived token from /api/speech/token.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional override. Leave blank to use https://<AZURE_SPEECH_REGION>.api.cognitive.microsoft.com/sts/v1.0/issueToken
AZURE_SPEECH_TOKEN_URL=

# Azure Bot Direct Line token broker
# Keep the Direct Line secret server-side. Never add it to a VITE_* variable.
AZURE_BOT_DIRECT_LINE_SECRET=
AZURE_BOT_DIRECT_LINE_TOKEN_URL=https://directline.botframework.com/v3/directline/tokens/generate
AZURE_BOT_DIRECT_LINE_TRUSTED_ORIGINS=http://localhost:5173
